  # 기본 0 인 이유: 실제 orca 와 달리 기존 시험들이 폴링(폴백) 경로를 검사하도록 유지.
  for _a in "$@"; do
    [ "$_a" = "--help" ] && {
      if [ "${FAKE_WAIT_SUPPORT:-0}" = 1 ]; then
        printf '%s\n' '  --wait    block until a matching message arrives or --timeout-ms expires'
      fi
      printf '%s\n' '  --json    emit machine-readable JSON'
      exit 0
    }
  done
  log_call "$*"
  previous=""
  ack=""
  requested_run=""
  for argument in "$@"; do
    [ "$previous" = "--ack" ] && ack="$argument"
    [ "$previous" = "--run" ] && requested_run="$argument"
    previous="$argument"
  done
  # --wait 흉내: --wait 가 있고 FAKE_WAIT_SUPPORT=1 이면 keepalive 한 줄을 stderr 로 내고
  # FAKE_WAIT_DELAY(기본 0)초 쉬어 실제 대기 시간을 흉내낸다(시험 루프 페이싱 + 생존 신호).
  for _a in "$@"; do
    if [ "$_a" = "--wait" ] && [ "${FAKE_WAIT_SUPPORT:-0}" = 1 ]; then
      printf '%s\n' '{"_keepalive":true,"_heartbeat":true,"elapsedMs":15001,"deadlineMs":60000}' >&2
      [ "${FAKE_WAIT_DELAY:-0}" != 0 ] && sleep "${FAKE_WAIT_DELAY:-0}"
      break
    fi
  done
  if [ -n "$ack" ]; then
    printf '%s\n' "$ack" >> "$ACK_LOG"
    # B11: ack 첫 시도만 실패시키는 스위치. 실패한 ack 은 phase 를 넘기지 않으므로 같은
    # Delivery 가 그대로 다시 배달된다(재시도 경로 재현). 두 번째 시도부터는 정상.
   if [ "${FAKE_ACK_FAIL_ONCE:-0}" = 1 ] && [ ! -f "$STATE_DIR/ack_failed_once" ]; then
     : > "$STATE_DIR/ack_failed_once"
     printf '%s\n' ack_failed >&2
     exit 9
   fi
    # H2(I-COMPANION-MAIN): ack 를 계속 실패시키는 스위치. phase 를 올리지 않으므로
    # 같은 배치가 매 check 에서 즉시 재생된다(미확인 배치 재생 고리). 한 번만 실패하는
    # FAKE_ACK_FAIL_ONCE 와는 다른 값이다 — companion wait/fallback 시험(H2)이 쓴다.
    if [ "${FAKE_ACK_FAIL:-0}" = 1 ]; then
      printf '%s\n' '{"error":{"code":"ack_rejected"}}' >&2
