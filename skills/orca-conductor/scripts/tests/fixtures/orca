      printf '%s\n' '{"result":{"messages":[{"id":"official_1","run_id":"run_project","type":"escalation","payload":{"taskId":"task_candidate","dispatchId":"ctx_candidate"}},{"id":"official_2","run_id":"run_project","type":"decision_gate","payload":{"taskId":"task_candidate","dispatchId":"ctx_candidate"}}]}}'
      ;;
    *)
      printf '%s\n' '{"result":{"messages":[]}}'
      ;;
  esac
  exit 0
fi

if [ "${1:-}" = "orchestration" ] && [ "${2:-}" = "send" ]; then
  log_call "$*"
  # F-B11-2: project Run 상신을 실패시키는 스위치. once=첫 시도만 실패(재시도 성공 경로),
  # always=계속 실패(재시도 한도 소진 경로). 시도 자체는 위 log_call 로 calls.log 에 남으므로
  # "몇 번 시도했는지"와 "몇 번 성공했는지"를 따로 셀 수 있다.
  case "${FAKE_PROJECT_SEND_FAIL:-}" in
    always)
      printf '%s\n' project_send_failed >&2
      exit 7
      ;;
    once)
      if [ ! -f "$STATE_DIR/project_send_failed_once" ]; then
        : > "$STATE_DIR/project_send_failed_once"
        printf '%s\n' project_send_failed >&2
        exit 7
      fi
      ;;
  esac
  printf '%s\n' "$*" >> "$PROJECT_SEND_LOG"
  printf '%s\n' '{"result":{"message":{"id":"project-message-1"}}}'
  exit 0
fi

printf '%s\n' "unexpected fake orca call: $*" >&2
exit 2
