#!/bin/bash
set -u

STATE_DIR="${FAKE_ORCA_STATE_DIR:?}"
MODE="${FAKE_RELAY_ALERT_MODE:-clean}"
DELIVERY_MODE="${FAKE_DELIVERY_MODE:-none}"
mkdir -p "$STATE_DIR"
CALLS="$STATE_DIR/calls.log"
SEND_LOG="$STATE_DIR/sends.log"
PROJECT_SEND_LOG="$STATE_DIR/project-sends.log"
ROSTER_LOG="$STATE_DIR/roster.log"
ACK_LOG="$STATE_DIR/acks.log"

# roster 응답의 판 신분 필드. 기본은 현재 판과 일치하고, 신분 불일치 시나리오 env 로
# 특정 역할의 특정 필드만 어긋나게 만들 수 있다.
identity_values() {
  identity_project=project_test
  identity_board=board_test
  identity_run="${FAKE_RUN_ID:-run_project}"
  identity_role="$1"
  identity_status=active
  identity_lifecycle=active
  identity_live=true
  identity_result_live=true
  if [ "$1" = relay ]; then
    identity_pane=pane_relay
  elif case "$1" in developer*|reviewer*|researcher*|investigator*) true;; *) false;; esac; then
    identity_pane="${FAKE_WORKER_PANE:-pane_worker}"
  else
    identity_pane=pane_supervisor
  fi
  if [ "$MODE" = start_wrong_relay ] && [ "$1" = relay ]; then
    identity_project=other_project
    identity_board=other_board
    identity_run=other_run
  fi
  if [ "${FAKE_ROSTER_WRONG_IDENTITY_ROLE:-}" = "$1" ] || [ "${FAKE_RESOLVE_WRONG_IDENTITY_ROLE:-}" = "$1" ]; then
    identity_project=other_project
    identity_board=other_board
    identity_run=other_run
  fi
  if [ "${FAKE_ROSTER_BAD_FIELD_ROLE:-project-supervisor}" = "$1" ]; then
    case "${FAKE_ROSTER_BAD_FIELD:-}" in
      project) identity_project=other_project ;;
      board) identity_board=other_board ;;
      role) identity_role=other_role ;;
      run) identity_run=other_run ;;
      status) identity_status=inactive ;;
      lifecycle) identity_lifecycle=closed ;;
      live) identity_live=false ;;
      result_live) identity_result_live=false ;;
      pane) identity_pane="" ;;
    esac
  fi
}

log_call() {
  printf '%s\n' "$*" >> "$CALLS"
}
phase() {
  cat "$STATE_DIR/phase" 2>/dev/null || printf '0\n'
}
candidate_message() {
  local message_id="$1" task_id="$2" dispatch_id="$3" cursor="$4" snippet="$5"
  printf '%s\n' "{\"message_id\":\"$message_id\",\"type\":\"relay_candidate\",\"sender_handle\":\"term_relay\",\"subject\":\"relay candidate\",\"payload\":{\"relayCandidate\":true,\"taskId\":\"$task_id\",\"dispatchId\":\"$dispatch_id\",\"outputCursor\":\"$cursor\",\"boundedSnippet\":\"$snippet\"}}"
}
candidate_delivery() {
  case "$MODE" in
    candidate_missing_id)
      printf '%s\n' '{"result":{"deliveryId":"delivery_candidate","messages":[{"message_id":"candidate_missing","type":"relay_candidate","sender_handle":"term_relay","subject":"bounded candidate missing ids","payload":{"relayCandidate":true,"outputCursor":"77","boundedSnippet":"waiting_for_kyle approval required"}}]}}'
      ;;
    candidate_ambiguous)
      printf '%s\n' '{"result":{"deliveryId":"delivery_candidate","messages":[{"message_id":"candidate_ambiguous","type":"relay_candidate","sender_handle":"term_relay","subject":"bounded candidate ambiguous","payload":{"relayCandidate":true,"taskId":"task_candidate","dispatchId":"ctx_candidate","outputCursor":"77","boundedSnippet":"approval requested","contextAmbiguous":true}}]}}'
      ;;
    candidate_duplicate)
      printf '%s\n' '{"result":{"deliveryId":"delivery_candidate","messages":[{"message_id":"candidate_1","type":"relay_candidate","sender_handle":"term_relay","subject":"candidate one","payload":{"relayCandidate":true,"taskId":"task_candidate","dispatchId":"ctx_candidate","outputCursor":"77","boundedSnippet":"waiting_for_kyle approval required"}},{"message_id":"candidate_2","type":"relay_candidate","sender_handle":"term_relay","subject":"candidate duplicate","payload":{"relayCandidate":true,"taskId":"task_candidate","dispatchId":"ctx_candidate","outputCursor":"77","boundedSnippet":"same cursor"}}]}}'
      ;;
    candidate_internal)
      printf '%s\n' '{"result":{"deliveryId":"delivery_candidate","messages":[{"message_id":"candidate_internal","type":"relay_candidate","sender_handle":"term_relay","subject":"internal wording","payload":{"relayCandidate":true,"taskId":"task_candidate","dispatchId":"ctx_candidate","outputCursor":"77","boundedSnippet":"project decision pending in project Run"}}]}}'
      ;;
    candidate_waiting)
      printf '%s\n' '{"result":{"deliveryId":"delivery_candidate","messages":[{"message_id":"candidate_waiting","type":"relay_candidate","sender_handle":"term_relay","subject":"waiting candidate","payload":{"relayCandidate":true,"taskId":"task_candidate","dispatchId":"ctx_candidate","outputCursor":"77","boundedSnippet":"waiting_for_kyle approval required"}}]}}'
      ;;
    candidate_present|candidate_ask|candidate_escalation|candidate_absent|clean)
      printf '%s\n' '{"result":{"deliveryId":"delivery_candidate","messages":[{"message_id":"candidate_1","type":"relay_candidate","sender_handle":"term_relay","subject":"relay candidate","payload":{"relayCandidate":true,"taskId":"task_candidate","dispatchId":"ctx_candidate","outputCursor":"77","boundedSnippet":"waiting_for_kyle approval required"}}]}}'
      ;;
    *)
      printf '%s\n' '{"result":{"deliveryId":"delivery_candidate","messages":[]}}'
      ;;
  esac
}

# F-B11-3: companion 이 실제로 만들어 올리는 구조 알림 편지 한 통을 그대로 재현한다.
# 위조 변형은 SA_* env 로 한 칸씩만 어긋나게 만든다(무엇 때문에 거부됐는지 1:1 로 보이게).
shape_alert_body() {
  printf 'companion이 우편함에서 모양이 깨진 편지 1통을 격리했습니다. 원문(제목·본문·payload·카드 식별자)은 싣지 않습니다. board=%s deliveryRef=%s index=%s type=%s reason=%s. 정상 형제 편지는 그대로 처리했고 큐는 막히지 않았습니다.' "$1" "$2" "$3" "$4" "$5"
}
shape_alert_letter() {
  local mid="$1"
  local sender="${SA_SENDER:-term_supervisor}" pane="${SA_PANE-pane_supervisor}"
  local ltype="${SA_TYPE:-escalation}" board="${SA_BOARD:-board_test}"
  local subject="${SA_SUBJECT:-message_shape_quarantined:board_test}"
  local ref="${SA_REF:-a1b2c3d4e5f6}" index="${SA_INDEX-0}"
  local mtype="${SA_MTYPE:-escalation}" reason="${SA_REASON:-message_id_type}"
  local body="${SA_BODY-}" extra="${SA_EXTRA:-}" pane_json="" id_key=message_id sender_key=sender_handle
  [ -n "$body" ] || body=$(shape_alert_body "$board" "$ref" "$index" "$mtype" "$reason")
  [ -n "$pane" ] && pane_json=",\"sender_pane_key\":\"$pane\""
  if [ "${SA_ALIAS:-0}" = 1 ]; then id_key=messageId; sender_key=sender; fi
  printf '{"%s":"%s","type":"%s","%s":"%s"%s,"subject":"%s","body":"%s","payload":{"messageShapeQuarantined":true,"board":"%s","deliveryRef":"%s","index":"%s","messageType":"%s","reason":"%s"%s}}' \
    "$id_key" "$mid" "$ltype" "$sender_key" "$sender" "$pane_json" "$subject" "$body" \
    "$board" "$ref" "$index" "$mtype" "$reason" "$extra"
}
# 위조 알림과 같은 Delivery 에 실리는 정상 형제. 위조 거부가 큐를 막지 않는지 본다.
shape_good_sibling() {
  printf '{"message_id":"good_beside_forged","type":"question","sender_handle":"term_worker","subject":"good question beside the forged alert","payload":{"task_id":"task_good","dispatch_id":"ctx_good"}}'
}
shape_forged_delivery() {
  printf '{"result":{"deliveryId":"delivery_shape_forged","messages":[%s,%s]}}\n' "$(shape_alert_letter shape_alert_forged)" "$(shape_good_sibling)"
}

if [ "${1:-}" = "roster" ] && [ "${2:-}" = "resolve" ]; then
  role=""
  previous=""
  for argument in "$@"; do
    if [ "$previous" = "--role" ]; then role="$argument"; break; fi
    previous="$argument"
  done
  printf '%s %s %s\n' resolve "$role" "$*" >> "$ROSTER_LOG"
  identity_values "$role"
  if [ "$role" = "relay" ]; then
    handle="${FAKE_RELAY_HANDLE:-term_relay}"
  elif case "$role" in developer*|reviewer*|researcher*|investigator*) true;; *) false;; esac; then
    # Per-role worker handle (R2 중요1): 역할별 env 가 우선, 없으면 공통 FAKE_WORKER_HANDLE.
    case "$role" in
      developer*) handle="${FAKE_WORKER_HANDLE_DEVELOPER:-${FAKE_WORKER_HANDLE:-}}" ;;
      reviewer*) handle="${FAKE_WORKER_HANDLE_REVIEWER:-${FAKE_WORKER_HANDLE:-}}" ;;
      researcher*) handle="${FAKE_WORKER_HANDLE_RESEARCHER:-${FAKE_WORKER_HANDLE:-}}" ;;
      investigator*) handle="${FAKE_WORKER_HANDLE_INVESTIGATOR:-${FAKE_WORKER_HANDLE:-}}" ;;
    esac
  else
    resolve_count=$(cat "$STATE_DIR/supervisor-resolve-count" 2>/dev/null || printf '0')
    resolve_count=$((resolve_count + 1))
    printf '%s\n' "$resolve_count" > "$STATE_DIR/supervisor-resolve-count"
    # F-B11-3: 편지를 배달한 바로 다음 supervisor resolve 만 못 찾게 만든다. 소비 시점에
    # 신분이 UNKNOWN 이 되는 상황(캐시된 옛 handle 만 믿으면 통과해버리는 자리)을 만들되,
    # 그 뒤 정상 형제 깨우기와 ack 은 계속 흐르게 둔다.
    if [ -f "$STATE_DIR/roster-fail-now" ]; then
      remaining=$(cat "$STATE_DIR/roster-fail-now" 2>/dev/null || printf '0')
      if [ "${remaining:-0}" -gt 0 ]; then
        printf '%s\n' "$((remaining - 1))" > "$STATE_DIR/roster-fail-now"
        printf '%s\n' 'role_roster_not_found' >&2
        exit 1
      fi
    fi
    fail_after="${FAKE_SUPERVISOR_RESOLVE_FAIL_AFTER:-0}"
    if [ "$fail_after" -gt 0 ] && [ "$resolve_count" -gt "$fail_after" ]; then
      printf '%s\n' 'role_roster_not_found' >&2
      exit 1
    fi
    # 특정 순번의 resolve 만 실패시킨다. owner mismatch 와 roster 실패를 섞는
    # 교차 시나리오에서 쓴다(한 줄에 실패시킬 resolve 순번 하나).
    fail_seq_file="$STATE_DIR/supervisor-resolve-fail-seq"
    if [ -f "$fail_seq_file" ] && grep -qx "$resolve_count" "$fail_seq_file"; then
      printf '%s\n' 'role_roster_not_found' >&2
      exit 1
    fi
    seq_file="$STATE_DIR/supervisor-handle-seq"
    if [ -f "$seq_file" ]; then
      handle=$(sed -n "${resolve_count}p" "$seq_file")
      [ -n "$handle" ] || handle=$(tail -1 "$seq_file")
    else
      handle="${FAKE_SUPERVISOR_HANDLE:-term_supervisor}"
    fi
  fi
  result_handle="$handle"
  if [ "${FAKE_ROSTER_BAD_FIELD_ROLE:-project-supervisor}" = "$role" ] && [ "${FAKE_ROSTER_BAD_FIELD:-}" = handle ]; then
    result_handle=term_other_window
  fi
  printf '%s\n' "{\"ok\":true,\"result\":{\"member\":{\"project\":\"$identity_project\",\"board\":\"$identity_board\",\"role\":\"$identity_role\",\"runId\":\"$identity_run\",\"pane\":\"$identity_pane\",\"status\":\"$identity_status\",\"lifecycle\":\"$identity_lifecycle\",\"live\":$identity_live,\"currentHandle\":\"$handle\"},\"currentHandle\":\"$result_handle\",\"live\":$identity_result_live}}"
  exit 0
fi

if [ "${1:-}" = "roster" ] && [ "${2:-}" = "list" ]; then
  role=""
  roster_status=""
  previous=""
  for argument in "$@"; do
    if [ "$previous" = "--role" ]; then role="$argument"; fi
    if [ "$previous" = "--status" ]; then roster_status="$argument"; fi
    previous="$argument"
  done
 log_call "$*"
  # R3 중요1: --role 없이 전체 active 멤버를 반환한다(worker 역할 발견용).
  # 시험에서 FAKE_ROSTER_ALL_MEMBERS 파일로 멤버 목록을 제어한다.
  # 없으면 supervisor + relay + env 제어 worker 멤버를 합친다.
  if [ -z "$role" ]; then
    if [ -f "$STATE_DIR/roster_all_members.json" ]; then
      cat "$STATE_DIR/roster_all_members.json"
    else
      identity_values project-supervisor
      sup_member="{\"id\":\"roster_sup\",\"project\":\"$identity_project\",\"board\":\"$identity_board\",\"role\":\"project-supervisor\",\"runId\":\"$identity_run\",\"pane\":\"$identity_pane\",\"status\":\"active\",\"lifecycle\":\"active\",\"live\":true,\"currentHandle\":\"term_supervisor\"}"
      identity_values relay
      relay_member="{\"id\":\"roster_relay\",\"project\":\"$identity_project\",\"board\":\"$identity_board\",\"role\":\"relay\",\"runId\":\"$identity_run\",\"pane\":\"pane_relay\",\"status\":\"active\",\"lifecycle\":\"active\",\"live\":true,\"currentHandle\":\"${FAKE_RELAY_HANDLE:-term_relay}\"}"
      members="$sup_member,$relay_member"
      wr="${FAKE_WORKER_ROLE:-}"
      wh="${FAKE_WORKER_HANDLE:-}"
      wp="${FAKE_WORKER_PANE:-pane_worker}"
      if [ -n "$wr" ] && [ -n "$wh" ]; then
        members="$members,{\"id\":\"roster_worker\",\"project\":\"$identity_project\",\"board\":\"$identity_board\",\"role\":\"$wr\",\"runId\":\"$identity_run\",\"pane\":\"$wp\",\"status\":\"active\",\"lifecycle\":\"active\",\"live\":true,\"currentHandle\":\"$wh\"}"
      fi
      printf '%s\n' "{\"ok\":true,\"result\":{\"members\":[$members]}}"
    fi
    exit 0
  fi
 # GATE_NUDGE 발신 창 이력 조회: supervisor의 inactive/retired 이력은 기본 비어 있고,
 # FAKE_SUPERVISOR_RETIRED_PANE가 있으면 그 pane의 retired member를 돌려준다
 # (세션 교대 전 정상 발송 편지가 새 감독 인수 뒤에도 유효한 수명 규칙 시험용).
 # 실물 RoleRosterMember 계약: retired 행의 권위 핸들은 currentHandle 이 아니라
 # lastSeenHandle 이다 — currentHandle 은 pane 재사용 시 현재 live 핸들을 가리키므로
 # retired 는 currentHandle=null,lastSeenHandle=교대 전 핸들 로 표현한다.
 if [ "$role" = project-supervisor ] && [ "$roster_status" = inactive ]; then
    printf '%s\n' '{"ok":true,"result":{"members":[]}}'
    exit 0
  fi
  if [ "$role" = project-supervisor ] && [ "$roster_status" = retired ]; then
    if [ -n "${FAKE_SUPERVISOR_RETIRED_PANE:-}" ]; then
      if [ "${FAKE_ROSTER_LIST_RETIRED_BAD:-0}" = "1" ]; then
        # retired 행이 불명확한 이력(권위 핸들 lastSeenHandle 없음)이면 wake 0 회귀.
        printf '%s\n' "{\"ok\":true,\"result\":{\"members\":[{\"id\":\"roster_supervisor_retired\",\"pane\":\"$FAKE_SUPERVISOR_RETIRED_PANE\",\"project\":\"project_test\",\"board\":\"board_test\",\"role\":\"project-supervisor\",\"runId\":\"run_project\",\"status\":\"retired\",\"lifecycle\":\"retired\",\"live\":false,\"currentHandle\":null}]}}"
      else
        printf '%s\n' "{\"ok\":true,\"result\":{\"members\":[{\"id\":\"roster_supervisor_retired\",\"pane\":\"$FAKE_SUPERVISOR_RETIRED_PANE\",\"project\":\"project_test\",\"board\":\"board_test\",\"role\":\"project-supervisor\",\"runId\":\"run_project\",\"status\":\"retired\",\"lifecycle\":\"retired\",\"live\":false,\"currentHandle\":null,\"lastSeenHandle\":\"term_old_supervisor\"}]}}"
      fi
    else
      printf '%s\n' '{"ok":true,"result":{"members":[]}}'
    fi
    exit 0
  fi
  if [ "$role" = relay ] && { [ "$MODE" = start_missing_relay ] || [ "$MODE" = start_duplicate_missing_relay ]; }; then
    printf '%s\n' '{"ok":true,"result":{"members":[]}}'
    exit 0
  fi
  if [ "$role" = relay ] || [ "$role" = project-supervisor ]; then
    identity_values "$role"
    handle=term_relay
    [ "$role" = project-supervisor ] && handle=term_supervisor
    # roster list 전용 회귀 오버라이드: resolve 는 정상으로 두고 supervisor 의 list
    # 응답만 특정 방식으로 깨뜨린다(GATE_NUDGE roster 권위 회귀 시험용).
    list_pane="$identity_pane"
    list_status="$identity_status"
    list_lifecycle="$identity_lifecycle"
    list_live="$identity_live"
    list_handle="$handle"
    if [ "$role" = project-supervisor ]; then
      case "${FAKE_ROSTER_LIST_BAD_FIELD:-}" in
        status) list_status=inactive ;;
        lifecycle) list_lifecycle=stale ;;
        live) list_live=false ;;
        handle) list_handle=term_other_window ;;
        pane) list_pane="" ;;
      esac
      if [ "${FAKE_ROSTER_LIST_EMPTY_ACTIVE:-0}" = "1" ] && [ "$roster_status" = active ]; then
        printf '%s\n' '{"ok":true,"result":{"members":[]}}'
        exit 0
      fi
      if [ "${FAKE_ROSTER_LIST_MALFORMED:-0}" = "1" ]; then
        printf '%s\n' '{"ok":true,"result":{"members":["oops"]}}'
        exit 0
      fi
      if [ "${FAKE_ROSTER_LIST_OK_FALSE:-0}" = "1" ]; then
        printf '%s\n' "{\"ok\":false,\"result\":{\"members\":[{\"id\":\"roster_$role\",\"pane\":\"$list_pane\",\"project\":\"$identity_project\",\"board\":\"$identity_board\",\"role\":\"$identity_role\",\"runId\":\"$identity_run\",\"status\":\"$list_status\",\"lifecycle\":\"$list_lifecycle\",\"live\":$list_live,\"currentHandle\":\"$list_handle\"}]}}"
        exit 0
      fi
    fi
    member="{\"id\":\"roster_$role\",\"pane\":\"$list_pane\",\"project\":\"$identity_project\",\"board\":\"$identity_board\",\"role\":\"$identity_role\",\"runId\":\"$identity_run\",\"status\":\"$list_status\",\"lifecycle\":\"$list_lifecycle\",\"live\":$list_live,\"currentHandle\":\"$list_handle\"}"
    if [ "${FAKE_ROSTER_MULTIPLE_ROLE:-}" = "$role" ]; then
      member="$member,{\"id\":\"roster_${role}_duplicate\",\"pane\":\"$list_pane\",\"project\":\"$identity_project\",\"board\":\"$identity_board\",\"role\":\"$identity_role\",\"runId\":\"$identity_run\",\"status\":\"$list_status\",\"lifecycle\":\"$list_lifecycle\",\"live\":$list_live,\"currentHandle\":\"$list_handle\"}"
    fi
    printf '%s\n' "{\"ok\":true,\"result\":{\"members\":[$member]}}"
  else
    printf '%s\n' '{"ok":true,"result":{"members":[]}}'
  fi
  exit 0
fi

if [ "${1:-}" = "terminal" ] && [ "${2:-}" = "send" ]; then
  log_call "$*"
  printf '%s\n' "$*" >> "$SEND_LOG"
  # F-B11-3: 특정 문구의 직접 깨우기만 골라서 실패시킨다. 정상 형제 깨우기는 그대로 두고
  # 비상 경로 한 줄만 막아, 실패가 조용히 묻히는지 아니면 소비되는지 가려낸다.
  if [ -n "${FAKE_SEND_FAIL_TEXT_MATCH:-}" ]; then
    case "$*" in
      *"$FAKE_SEND_FAIL_TEXT_MATCH"*)
        if [ "${FAKE_SEND_FAIL_TEXT_ONCE:-0}" = 1 ] && [ -f "$STATE_DIR/send_text_failed_once" ]; then
          :
        else
          [ "${FAKE_SEND_FAIL_TEXT_ONCE:-0}" != 1 ] || : > "$STATE_DIR/send_text_failed_once"
          printf '%s\n' send_text_failed >&2
          exit 7
        fi
        ;;
    esac
  fi
  case " $* " in
    *" --enter "*) [ "${FAKE_ENTER_MODE:-ok}" != fail ] || exit 7 ;;
  esac
  printf '%s\n' '{"ok":true}'
  exit 0
fi

# Relay-only fixture: the companion never invokes this path.
if [ "${1:-}" = "terminal" ] && [ "${2:-}" = "read" ]; then
  handle=""
  cursor=""
  limit=""
  previous=""
  for argument in "$@"; do
    [ "$previous" = "--terminal" ] && handle="$argument"
    [ "$previous" = "--cursor" ] && cursor="$argument"
    [ "$previous" = "--limit" ] && limit="$argument"
    previous="$argument"
  done
  log_call "$*"
  [ "$handle" = term_supervisor ] || exit 8
  [ "$MODE" = relay_bounded ] || {
    printf '%s\n' '{"result":{"terminal":{"tail":[],"oldestCursor":"0","nextCursor":"0","latestCursor":"0","truncated":false}}}'
    exit 0
  }
  printf '%s\n' "{\"result\":{\"terminal\":{\"tail\":[\"FINAL_ASSISTANT_OUTPUT taskId=task_candidate dispatchId=ctx_candidate waiting_for_kyle\"],\"oldestCursor\":\"10\",\"nextCursor\":\"12\",\"latestCursor\":\"12\",\"truncated\":false}}}"
  exit 0
fi

if [ "${1:-}" = "orchestration" ] && [ "${2:-}" = "run-show" ]; then
  log_call "$*"
  if [ "${FAKE_RUN_SHOW_FAIL:-0}" = "1" ]; then
    printf '%s\n' 'run_show_failed' >&2
    exit 1
  fi
  show_id=""
  previous=""
  for argument in "$@"; do
    [ "$previous" = "--id" ] && show_id="$argument"
    previous="$argument"
  done
  show_count=$(cat "$STATE_DIR/coordinator-show-count" 2>/dev/null || printf '0')
  show_count=$((show_count + 1))
  printf '%s\n' "$show_count" > "$STATE_DIR/coordinator-show-count"
  coord_seq="$STATE_DIR/coordinator-handle-seq"
  coord_pane_seq="$STATE_DIR/coordinator-pane-seq"
  if [ -f "$coord_seq" ]; then
    coord_handle=$(sed -n "${show_count}p" "$coord_seq")
    [ -n "$coord_handle" ] || coord_handle=$(tail -1 "$coord_seq")
  else
    coord_handle="${FAKE_SUPER_COORDINATOR_HANDLE:-term_super_coord}"
  fi
  if [ -f "$coord_pane_seq" ]; then
    coord_pane=$(sed -n "${show_count}p" "$coord_pane_seq")
    [ -n "$coord_pane" ] || coord_pane=$(tail -1 "$coord_pane_seq")
  else
    # `-` 형태라 빈 문자열을 명시하면 pane 없는 run-show 응답을 재현한다.
    coord_pane="${FAKE_SUPER_COORDINATOR_PANE-pane_super_coord}"
  fi
  # 요청한 --super-run 과 다른 Run 을 돌려주는 공격 재현용 override.
  run_show_id="${FAKE_SUPER_RUN_SHOW_ID-${show_id:-run_super}}"
  printf '%s\n' "{\"result\":{\"run\":{\"id\":\"$run_show_id\",\"coordinator_handle\":\"$coord_handle\",\"coordinator_pane_key\":\"$coord_pane\",\"consumer_generation\":1}}}"
  exit 0
fi

if [ "${1:-}" = "orchestration" ] && [ "${2:-}" = "task-list" ]; then
