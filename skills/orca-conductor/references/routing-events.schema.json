{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyle.local/orca/routing-events.schema.json",
  "title": "Orca routing event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "board",
    "repoId",
    "taskId",
    "runId",
    "roundId",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "enum": [
        "routing_decision",
        "execution_finished",
        "review_finished",
        "checkpoint_committed",
        "quality_feedback",
        "routing_selected_auto",
        "dispatch_auto",
        "worker_done_auto"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "board": {
      "type": "string",
      "minLength": 1
    },
    "repoId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "roundId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "routing_decision"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/routingDecision"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "execution_finished"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/executionFinished"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "review_finished"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/reviewFinished"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "checkpoint_committed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/checkpointCommitted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "quality_feedback"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/qualityFeedback"
          }
        }
      }
    }
  ],
  "$defs": {
    "role": {
      "enum": [
        "developer",
        "reviewer",
        "researcher"
      ]
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ]
    },
    "taskClass": {
      "enum": [
        "targeted_implementation",
        "frontend",
        "architecture",
        "research",
        "security",
        "concurrency",
        "bugfix",
        "docs_config",
        "qa",
        "other"
      ]
    },
    "source": {
      "enum": [
        "measured",
        "reported",
        "derived",
        "unknown"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "modelVersion",
        "role",
        "effort",
        "profile"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "modelVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskClass",
        "weight",
        "roundIndex",
        "riskFlags"
      ],
      "properties": {
        "taskClass": {
          "$ref": "#/$defs/taskClass"
        },
        "weight": {
          "enum": [
            "LIGHT",
            "HEAVY"
          ]
        },
        "roundIndex": {
          "type": "integer",
          "minimum": 0
        },
        "riskFlags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "security",
              "concurrency",
              "migration",
              "external_api",
              "multi_repo",
              "user_visible",
              "production_data",
              "unknown_design"
            ]
          }
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "capturedAt",
        "weeklyUsedPercent",
        "fiveHourUsedPercent"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "weeklyUsedPercent": {
          "$ref": "#/$defs/metric"
        },
        "fiveHourUsedPercent": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment",
        "eligible",
        "exclusionReason",
        "qualityPrior",
        "observedQuality",
        "quotaScore",
        "diversityScore",
        "totalScore"
      ],
      "properties": {
        "assignment": {
          "$ref": "#/$defs/assignment"
        },
        "eligible": {
          "type": "boolean"
        },
        "exclusionReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualityPrior": {
          "$ref": "#/$defs/metric"
        },
        "observedQuality": {
          "$ref": "#/$defs/metric"
        },
        "quotaScore": {
          "$ref": "#/$defs/metric"
        },
        "diversityScore": {
          "$ref": "#/$defs/metric"
        },
        "totalScore": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "exitCode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "blocked"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "routingDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routerVersion",
        "context",
        "selected",
        "isExploration",
        "selectionProbability",
        "candidates",
        "quotaSnapshots"
      ],
      "properties": {
        "routerVersion": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "selected": {
          "$ref": "#/$defs/assignment"
        },
        "isExploration": {
          "type": "boolean"
        },
        "selectionProbability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "quotaSnapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quota"
          }
        }
      }
    },
    "executionFinished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment",
        "status",
        "durationMs",
        "tokenCount",
        "filesModifiedCount",
        "verifications"
      ],
      "properties": {
        "assignment": {
          "$ref": "#/$defs/assignment"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "not_started"
          ]
        },
        "durationMs": {
          "$ref": "#/$defs/metric"
        },
        "tokenCount": {
          "$ref": "#/$defs/metric"
        },
        "filesModifiedCount": {
          "type": "integer",
          "minimum": 0
        },
        "verifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verification"
          }
        }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical",
        "major",
        "minor",
        "observation"
      ],
      "properties": {
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "observation": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reviewFinished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment",
        "targetRunId",
        "verdict",
        "findings",
        "verifications"
      ],
      "properties": {
        "assignment": {
          "$ref": "#/$defs/assignment"
        },
        "targetRunId": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": [
            "pass",
            "revise",
            "blocked"
          ]
        },
        "findings": {
          "$ref": "#/$defs/findings"
        },
        "verifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verification"
          }
        }
      }
    },
    "checkpointCommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRunId",
        "commitSha"
      ],
      "properties": {
        "targetRunId": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "qualityFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRunId",
        "kind",
        "outcome",
        "evidenceId"
      ],
      "properties": {
        "targetRunId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "battle_result",
            "false_positive",
            "escaped_defect",
            "production_regression"
          ]
        },
        "outcome": {
          "enum": [
            "positive",
            "negative",
            "neutral"
          ]
        },
        "evidenceId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
